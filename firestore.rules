rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // Public version check. Clients cannot change the minimum version.
    match /appConfig/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Seeded + read by the app on splash / login
    match /safetyCategories/{id} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    match /vesselTypes/{id} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    match /vesselUses/{id} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }
  }
}
