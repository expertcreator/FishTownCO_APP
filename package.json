{
  "name": "fishtownco-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "bunx expo start -c",
    "dev:android": "bunx expo start -c --android",
    "dev:ios": "bunx expo start -c --ios",
    "dev:web": "bunx expo start -c --web",
    "android": "bunx expo run:android",
    "ios": "bunx expo run:ios",
    "android:debug:dev": "EXPO_PUBLIC_APP_VARIANT=development EXPO_PUBLIC_APP_BRAND=fishtownco bunx expo run:android",
    "android:debug:staging": "EXPO_PUBLIC_APP_VARIANT=staging EXPO_PUBLIC_APP_BRAND=fishtownco bunx expo run:android",
    "android:debug:prod": "EXPO_PUBLIC_APP_VARIANT=production EXPO_PUBLIC_APP_BRAND=fishtownco bunx expo run:android",
    "ios:debug:dev": "EXPO_PUBLIC_APP_VARIANT=development EXPO_PUBLIC_APP_BRAND=fishtownco bunx expo run:ios",
    "ios:debug:staging": "EXPO_PUBLIC_APP_VARIANT=staging EXPO_PUBLIC_APP_BRAND=fishtownco bunx expo run:ios",
    "win:android:dev": "bun scripts/run-android-debug.mjs development",
    "win:android:staging": "bun scripts/run-android-debug.mjs staging",
    "win:android:prod": "bun scripts/run-android-debug.mjs production",
    "win:android:apk": "bun scripts/build-android-apk.mjs",
    "win:android:apk:release": "bun scripts/build-android-apk.mjs --release",
    "android:assemble-release": "bun scripts/build-android-apk.mjs --release",
    "win:eas:build:android:dev": "node scripts/build.mjs --env development --platform android --mode eas",
    "win:eas:build:android:staging": "node scripts/build.mjs --env staging --platform android --mode eas",
    "win:eas:build:android:prod": "node scripts/build.mjs --env prod --platform android --mode eas",
    "win:eas:build:android:prod-apk": "bun run eas:build:android:prod-apk",
    "win:eas:build:local:android:dev": "node scripts/eas-android-build.mjs --profile development --local",
    "win:eas:build:local:android:staging": "node scripts/eas-android-build.mjs --profile preview --local",
    "win:eas:build:local:android:prod": "node scripts/eas-android-build.mjs --profile production --local",
    "eas:build:local:android:dev": "SENTRY_DISABLE_AUTO_UPLOAD=true bunx eas build --profile development --platform android --local",
    "eas:build:local:android:staging": "SENTRY_DISABLE_AUTO_UPLOAD=true bunx eas build --profile preview --platform android --local",
    "eas:build:local:android:prod": "SENTRY_DISABLE_AUTO_UPLOAD=true bunx eas build --profile production --platform android --local",
    "eas:build:android:dev": "node scripts/build.mjs --env development --platform android --mode eas",
    "eas:build:android:staging": "node scripts/build.mjs --env staging --platform android --mode eas",
    "eas:build:android:prod": "node scripts/build.mjs --env prod --platform android --mode eas",
    "eas:build:android:prod-apk": "SENTRY_DISABLE_AUTO_UPLOAD=true bunx eas-cli build --profile production-apk --platform android --non-interactive",
    "eas:build:ios:staging": "node scripts/build.mjs --env staging --platform ios --mode eas",
    "eas:build:ios:prod": "node scripts/build.mjs --env prod --platform ios --mode eas",
    "eas:build:all:staging": "bun run eas:build:android:staging && bun run eas:build:ios:staging",
    "eas:build:all:prod": "bun run eas:build:android:prod && bun run eas:build:ios:prod",
    "eas:update:staging": "node scripts/build.mjs --env staging --platform all --mode update",
    "eas:update:prod": "node scripts/build.mjs --env prod --platform all --mode update",
    "eas:submit:ios:staging": "bunx eas submit --platform ios --profile preview --non-interactive --latest",
    "eas:submit:ios:prod": "bunx eas submit --platform ios --profile production --non-interactive --latest",
    "eas:submit:android:staging": "bunx eas submit --platform android --profile preview --non-interactive --latest",
    "eas:submit:android:prod": "bunx eas submit --platform android --profile production --non-interactive --latest",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.2.1",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.3",
    "expo-constants": "~57.0.6",
    "expo-dev-client": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-router": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.62.0",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-mmkv": "^3.3.1",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.0",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.6",
    "@types/node": "^22.10.0",
    "@types/react": "~19.2.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^16.4.5",
    "expo-build-properties": "~57.0.6",
    "typescript": "~6.0.3",
    "ultracite": "5.6.4"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
